PORT=3000
NODE_ENV=development

# Backend URL for CORS
CLIENT_URL=http://localhost:4200

# Database (configure in Phase 3)
DATABASE_URL=postgres://user:password@localhost:5432/shopee_tracker

# JWT (configure in Phase 4)
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Telegram (configure in Phase 9)
TELEGRAM_BOT_TOKEN=your-bot-token
